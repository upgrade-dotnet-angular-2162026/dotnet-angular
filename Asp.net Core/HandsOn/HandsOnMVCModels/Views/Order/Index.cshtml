@model List<HandsOnMVCModels.Models.Order>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>OrderId</th>
                <th>Customer</th>
                <th>OrderTotal</th>
                <th>OrderDate</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach(var order in Model)
                {
                    <tr>
                    <td>@order.OrderId</td>
                    <td>@order.CustomerId</td>
                    <td>@order.TotalPrice</td>
                    <td>@order.OrderDate</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


